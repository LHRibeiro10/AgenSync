generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum ExpenseRecurrence {
  ONCE
  MONTHLY
}

enum MonthlyPlanStatus {
  ACTIVE
  PAUSED
  CANCELED
}

enum MonthlyPaymentStatus {
  PENDING
  PAID
  OVERDUE
  CANCELED
}

enum MonthlyBillingType {
  PER_COMPLETED_SESSION
  FIXED_MONTHLY
  PACKAGE_MONTHLY
}

enum MonthlyPriceMode {
  SERVICE_PRICE
  CUSTOM_SESSION_PRICE
  MONTHLY_PRICE
}

enum MonthlyRecurrenceType {
  WEEKLY
  BIWEEKLY
  MONTHLY
  WEEKDAYS
  EVERY_X_DAYS
  MANUAL_DATES
}

enum UserRole {
  ADMIN
  USER
}

enum WorkspaceRole {
  OWNER
  ADMIN
  PROFESSIONAL
}

enum PlatformRole {
  USER
  SUPPORT
  DEVELOPER
  PLATFORM_OWNER
}

enum AccountSubscriptionStatus {
  PAID
  TRIAL
  TRIALING
  ACTIVE
  PAST_DUE
  BLOCKED
  CANCELED
  MANUAL_UNLOCKED
}

enum BillingProvider {
  MANUAL
  STRIPE
  MERCADO_PAGO
  ASAAS
}

enum BillingInvoiceStatus {
  DRAFT
  OPEN
  PAID
  OVERDUE
  VOID
  UNCOLLECTIBLE
  CANCELED
  REFUNDED
}

enum BillingWebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum AccountOperationalStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum UserAccountStatus {
  ACTIVE
  INACTIVE
}

enum WorkspaceMemberStatus {
  ACTIVE
  INVITED
  DISABLED
}

enum WorkspaceInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  CANCELED
}

enum ReminderType {
  TEN_MINUTES_BEFORE
  FIFTEEN_MINUTES_BEFORE
  ONE_DAY_BEFORE
  TWO_HOURS_BEFORE
  ONE_HOUR_BEFORE
  THIRTY_MINUTES_BEFORE
}

enum ReminderStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(USER)
  workspaceRole WorkspaceRole  @default(OWNER)
  platformRole  PlatformRole? @default(USER)
  platformPlan  String?
  accountStatus AccountOperationalStatus @default(ACTIVE)
  userStatus    UserAccountStatus @default(ACTIVE)
  subscriptionStatus AccountSubscriptionStatus @default(TRIALING)
  subscriptionPaidUntil DateTime?
  temporaryAccessUntil DateTime?
  billingEnabled Boolean @default(false)
  currentWorkspaceId String?
  currentWorkspace Workspace? @relation("CurrentWorkspace", fields: [currentWorkspaceId], references: [id], onDelete: SetNull)
  sentWorkspaceInvites WorkspaceInvite[] @relation("WorkspaceInvitesSent")
  businessName  String
  businessLogo  String?
  businessType  String
  businessTypeCustom String?
  businessPhone String?
  businessCity  String?
  businessAddress String?
  onboardingCompleted Boolean @default(false)
  onboardingCompletedAt DateTime?
  professionalId String?
  whatsappReminderEnabled Boolean @default(false)
  whatsappReminderOffsetMinutes Int @default(120)
  whatsappReminderMessage String?
  whatsappReminderTestPhone String?
  whatsappConfirmationMessage String?
  appointmentNotificationsEnabled Boolean @default(true)
  appointmentNotificationOffsetMinutes Int @default(30)
  appointmentNotificationChannels Json @default("[\"internal\",\"push\"]")
  ownedWorkspaces Workspace[] @relation("WorkspaceOwner")
  workspaceMembers WorkspaceMember[]
  clients       Client[]
  professionals Professional[]
  services      Service[]
  appointments  Appointment[]
  expenses      Expense[]
  products      Product[]
  productSales  ProductSale[]
  monthlyPlans  MonthlyPlan[]
  auditLogs     AuditLog[]
  notificationTokens NotificationToken[]
  pushSubscriptions PushSubscription[]
  notifications Notification[]
  appointmentReminders AppointmentReminder[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([role])
  @@index([workspaceRole])
  @@index([platformRole])
  @@index([platformPlan])
  @@index([accountStatus])
  @@index([userStatus])
  @@index([subscriptionStatus])
  @@index([currentWorkspaceId])
  @@index([onboardingCompleted])
  @@index([professionalId])
  @@index([createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String?
  eventType String
  message   String?
  ipAddress String?
  userAgent String?
  route     String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([workspaceId, createdAt])
  @@index([workspaceId, eventType, createdAt])
  @@index([eventType, createdAt])
  @@index([userId, createdAt])
}

model Client {
  id           String            @id @default(cuid())
  workspaceId  String?
  workspace    Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  phone        String
  email        String?
  cpf          String?
  cnpj         String?
  rg           String?
  birthDate    DateTime?
  zipCode      String?
  address      String?
  addressNumber String?
  addressComplement String?
  district     String?
  state        String?
  city         String?
  tags         String?
  source       String?
  externalId   String?
  notes        String?
  photoUrl     String?
  internalPreferences String?
  isActive     Boolean           @default(true)
  appointments Appointment[]
  productSales ProductSale[]
  monthlyPlans MonthlyPlan[]
  careRecord   ClientCareRecord?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, name])
  @@index([workspaceId, phone])
  @@index([workspaceId, email])
  @@index([workspaceId, isActive])
  @@index([userId])
  @@index([userId, name])
  @@index([userId, phone])
  @@index([userId, email])
  @@index([userId, isActive])
  @@index([userId, cpf])
  @@index([userId, externalId])
  @@index([userId, createdAt])
}

model Expense {
  id          String            @id @default(cuid())
  workspaceId String?
  workspace   Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  description String
  category    String
  amount      Decimal           @db.Decimal(10, 2)
  date        DateTime
  recurrence  ExpenseRecurrence @default(ONCE)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workspaceId, date])
  @@index([workspaceId, category, date])
  @@index([userId, date])
  @@index([userId, category, date])
  @@index([userId, createdAt])
}

model Product {
  id              String                 @id @default(cuid())
  workspaceId     String?
  workspace       Workspace?             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  category        String
  costPrice       Decimal                @db.Decimal(10, 2)
  salePrice       Decimal                @db.Decimal(10, 2)
  stockQty        Int                    @default(0)
  minStock        Int                    @default(0)
  description     String?
  isActive        Boolean                @default(true)
  brand           String?
  supplierName    String?
  supplierContact String?
  sku             String?
  unit            String                 @default("unidade")
  expirationDate  DateTime?
  usageType       String                 @default("revenda")
  sales           ProductSale[]
  variants        ProductVariant[]
  movements       ProductStockMovement[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@index([workspaceId, category])
  @@index([workspaceId, isActive, name])
  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, category])
  @@index([userId, isActive, name])
  @@index([userId, createdAt])
}

model ProductVariant {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  label     String
  sku       String?
  costPrice Decimal  @db.Decimal(10, 2)
  salePrice Decimal  @db.Decimal(10, 2)
  stockQty  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model ProductStockMovement {
  id             String   @id @default(cuid())
  productId      String
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId      String?
  type           String
  quantity       Int
  supplierName   String?
  clientId       String?
  professionalId String?
  note           String?
  createdAt      DateTime @default(now())

  @@index([productId, createdAt])
}

model ProductSale {
  id          String   @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  productName String
  unitPrice   Decimal  @db.Decimal(10, 2)
  unitCost    Decimal  @db.Decimal(10, 2)
  quantity    Int
  total       Decimal  @db.Decimal(10, 2)
  date        DateTime
  notes       String?
  createdAt   DateTime @default(now())

  @@index([workspaceId, date])
  @@index([workspaceId, productId, date])
  @@index([workspaceId, clientId, date])
  @@index([userId, date])
  @@index([userId, productId, date])
  @@index([userId, clientId, date])
  @@index([userId, createdAt])
}

model MonthlyPlan {
  id         String               @id @default(cuid())
  workspaceId String?
  workspace Workspace?            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId     String
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId   String
  client     Client               @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId  String?
  service    Service?             @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  professionalId String?
  professional Professional?      @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  planName   String
  amount     Decimal              @db.Decimal(10, 2)
  dueDay     Int
  startDate  DateTime
  endDate    DateTime?
  billingType MonthlyBillingType  @default(FIXED_MONTHLY)
  priceMode  MonthlyPriceMode     @default(MONTHLY_PRICE)
  monthlyPrice Decimal?           @db.Decimal(10, 2)
  sessionPrice Decimal?           @db.Decimal(10, 2)
  sessionsPerMonth Int            @default(1)
  recurrenceType MonthlyRecurrenceType @default(MONTHLY)
  recurrenceConfig Json           @default("{}")
  defaultStartTime String?
  durationMinutes Int?
  generateAppointments Boolean    @default(false)
  generatedUntil DateTime?
  status     MonthlyPlanStatus    @default(ACTIVE)
  pausedAt   DateTime?
  canceledAt DateTime?
  notes      String?
  payments   MonthlyPlanPayment[]
  appointments Appointment[]
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, clientId])
  @@index([workspaceId, serviceId])
  @@index([workspaceId, professionalId])
  @@index([workspaceId, billingType])
  @@index([workspaceId, startDate])
  @@index([workspaceId, status, startDate], map: "idx_monthly_plan_workspace_status_start")
  @@index([workspaceId, professionalId, status, startDate], map: "idx_monthly_plan_workspace_prof_status_start")
  @@index([workspaceId, billingType, status], map: "idx_monthly_plan_workspace_billing_status")
  @@index([workspaceId, createdAt], map: "idx_monthly_plan_workspace_created")
  @@index([userId, status])
  @@index([userId, clientId])
  @@index([userId, serviceId])
  @@index([userId, professionalId])
  @@index([userId, billingType])
  @@index([userId, startDate])
  @@index([userId, status, createdAt])
  @@index([userId, createdAt])
}

model MonthlyPlanPayment {
  id            String               @id @default(cuid())
  monthlyPlanId String
  monthlyPlan   MonthlyPlan          @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)
  month         String
  status        MonthlyPaymentStatus @default(PENDING)
  dueDate       DateTime?
  paidAt        DateTime?
  amount        Decimal              @db.Decimal(10, 2)
  paymentMethod String?
  notes         String?
  manual        Boolean              @default(false)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([monthlyPlanId, month])
  @@index([month, status])
  @@index([dueDate, status])
  @@index([monthlyPlanId, month, status], map: "idx_monthly_payment_plan_month_status")
  @@index([month, status, dueDate], map: "idx_monthly_payment_month_status_due")
}

model Workspace {
  id             String                    @id @default(cuid())
  name           String
  slug           String?                   @unique
  ownerId        String
  owner          User                      @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  plan           String                    @default("padrao")
  planStatus     AccountSubscriptionStatus @default(TRIALING)
  trialStartedAt DateTime?
  trialEndsAt    DateTime?
  currentUsers   User[]                    @relation("CurrentWorkspace")
  members        WorkspaceMember[]
  clients        Client[]
  professionals  Professional[]
  services       Service[]
  appointments   Appointment[]
  expenses       Expense[]
  products       Product[]
  productSales   ProductSale[]
  monthlyPlans   MonthlyPlan[]
  billingCustomer BillingCustomer?
  billingSubscriptions BillingSubscription[]
  billingInvoices BillingInvoice[]
  billingWebhookEvents BillingWebhookEvent[]
  careRecords    ClientCareRecord[]
  notifications  Notification[]
  invites        WorkspaceInvite[]
  auditLogs      AuditLog[]
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt

  @@index([ownerId])
  @@index([plan])
  @@index([planStatus])
  @@index([createdAt])
}

model BillingCustomer {
  id                 String          @id @default(cuid())
  workspaceId        String          @unique
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  provider           BillingProvider @default(MANUAL)
  providerCustomerId String?
  email              String?
  name               String?
  metadata           Json            @default("{}")
  subscriptions      BillingSubscription[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([provider, providerCustomerId])
  @@index([provider])
  @@index([email])
}

model BillingSubscription {
  id                     String                    @id @default(cuid())
  workspaceId            String
  workspace              Workspace                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingCustomerId      String?
  billingCustomer        BillingCustomer?          @relation(fields: [billingCustomerId], references: [id], onDelete: SetNull)
  provider               BillingProvider           @default(MANUAL)
  providerSubscriptionId String?
  providerPriceId        String?
  plan                   String
  status                 AccountSubscriptionStatus @default(TRIALING)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  trialEndsAt            DateTime?
  cancelAtPeriodEnd      Boolean                   @default(false)
  canceledAt             DateTime?
  metadata               Json                      @default("{}")
  invoices               BillingInvoice[]
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  @@unique([provider, providerSubscriptionId])
  @@index([workspaceId, status])
  @@index([workspaceId, plan])
  @@index([provider, status])
  @@index([providerPriceId])
  @@index([currentPeriodEnd])
}

model BillingInvoice {
  id                        String               @id @default(cuid())
  workspaceId               String
  workspace                 Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  billingSubscriptionId     String?
  billingSubscription       BillingSubscription? @relation(fields: [billingSubscriptionId], references: [id], onDelete: SetNull)
  provider                  BillingProvider      @default(MANUAL)
  providerInvoiceId         String?
  providerPaymentId         String?
  providerCheckoutSessionId String?
  amount                    Decimal              @db.Decimal(10, 2)
  currency                  String               @default("BRL")
  status                    BillingInvoiceStatus @default(OPEN)
  dueAt                     DateTime?
  paidAt                    DateTime?
  hostedUrl                 String?
  pdfUrl                    String?
  metadata                  Json                 @default("{}")
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  @@unique([provider, providerInvoiceId])
  @@index([workspaceId, status])
  @@index([workspaceId, dueAt])
  @@index([provider, status])
  @@index([providerCheckoutSessionId])
}

model BillingWebhookEvent {
  id           String               @id @default(cuid())
  workspaceId  String?
  workspace    Workspace?           @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  provider     BillingProvider
  eventId      String
  eventType    String
  status       BillingWebhookStatus @default(RECEIVED)
  payload      Json
  errorMessage String?
  receivedAt   DateTime             @default(now())
  processedAt  DateTime?

  @@unique([provider, eventId])
  @@index([workspaceId, receivedAt])
  @@index([provider, eventType])
  @@index([status, receivedAt])
}

model WorkspaceMember {
  id             String                @id @default(cuid())
  workspaceId    String
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           WorkspaceRole         @default(PROFESSIONAL)
  permissions    Json                  @default("{}")
  professionalId String?
  professional   Professional?         @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  status         WorkspaceMemberStatus @default(ACTIVE)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([workspaceId, status])
  @@index([userId, status])
  @@index([professionalId])
}

model WorkspaceInvite {
  id             String                @id @default(cuid())
  workspaceId    String
  workspace      Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email          String
  phone          String?
  name           String?
  role           WorkspaceRole
  permissions    Json                  @default("{}")
  professionalId String?
  professional   Professional?         @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  token          String                @unique
  status         WorkspaceInviteStatus @default(PENDING)
  invitedById    String?
  invitedBy      User?                 @relation("WorkspaceInvitesSent", fields: [invitedById], references: [id], onDelete: SetNull)
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([workspaceId, status])
  @@index([workspaceId, email])
  @@index([workspaceId, phone])
  @@index([professionalId])
  @@index([invitedById])
  @@index([expiresAt])
}

model ClientCareRecord {
  id         String   @id @default(cuid())
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  clientId   String   @unique
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  anamnesis  Json?
  documents  Json     @default("[]")
  budgets    Json     @default("[]")
  forms      Json     @default("[]")
  photos     Json     @default("[]")
  evolutions Json     @default("[]")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([workspaceId])
}

model Service {
  id              String        @id @default(cuid())
  workspaceId     String?
  workspace       Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  priceDefault    Decimal       @db.Decimal(10, 2)
  durationMinutes Int
  isActive        Boolean       @default(true)
  appointments    Appointment[]
  monthlyPlans    MonthlyPlan[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@index([workspaceId, isActive, name])
  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, isActive, name])
  @@index([userId, createdAt])
}

model Professional {
  id           String        @id @default(cuid())
  workspaceId  String?
  workspace    Workspace?    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  role         String?
  email        String?
  phone        String?
  monthlyGoal  Decimal?      @db.Decimal(10, 2)
  isActive     Boolean       @default(true)
  appointments Appointment[]
  monthlyPlans MonthlyPlan[]
  workspaceMembers WorkspaceMember[]
  workspaceInvites WorkspaceInvite[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([workspaceId])
  @@index([workspaceId, isActive])
  @@index([workspaceId, name])
  @@index([workspaceId, email])
  @@index([workspaceId, isActive, name])
  @@index([userId])
  @@index([userId, isActive])
  @@index([userId, name])
  @@index([userId, email])
  @@index([userId, isActive, name])
  @@index([userId, createdAt])
}

model Appointment {
  id              String            @id @default(cuid())
  workspaceId     String?
  workspace       Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId          String
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId        String
  client          Client            @relation(fields: [clientId], references: [id], onDelete: Restrict)
  serviceId       String
  service         Service           @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  professionalId  String?
  professional    Professional?     @relation(fields: [professionalId], references: [id], onDelete: Restrict)
  monthlyPlanId   String?
  monthlyPlan     MonthlyPlan?      @relation(fields: [monthlyPlanId], references: [id], onDelete: SetNull)
  startsAt        DateTime
  endsAt          DateTime
  durationMinutes Int?
  price           Decimal           @db.Decimal(10, 2)
  notes           String?
  status          AppointmentStatus @default(SCHEDULED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  reminders       AppointmentReminder[]

  @@index([workspaceId, startsAt])
  @@index([workspaceId, status, startsAt])
  @@index([workspaceId, clientId])
  @@index([workspaceId, professionalId, startsAt])
  @@index([workspaceId, monthlyPlanId, startsAt])
  @@index([userId, startsAt])
  @@index([userId, status, startsAt])
  @@index([userId, clientId])
  @@index([userId, professionalId, startsAt])
  @@index([userId, monthlyPlanId, startsAt])
  @@index([userId, createdAt])
}

model NotificationToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String    @unique
  platform   String
  userAgent  String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastUsedAt DateTime?
  disabledAt DateTime?

  @@index([userId])
  @@index([userId, disabledAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  keys      Json
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  title     String
  body      String?
  type      String    @default("info")
  actionUrl String?
  relatedEntityType String?
  relatedEntityId String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([userId, relatedEntityType, relatedEntityId])
  @@index([workspaceId, createdAt])
}

model AppointmentReminder {
  id            String         @id @default(cuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  reminderType  ReminderType
  scheduledFor  DateTime
  sentAt        DateTime?
  status        ReminderStatus @default(PENDING)
  errorMessage  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([appointmentId, reminderType])
  @@index([status, scheduledFor])
  @@index([userId])
  @@index([appointmentId])
}
