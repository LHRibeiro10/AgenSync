# Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/agensync?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/agensync?schema=public"
DATABASE_POOL_MAX=5

# Auth and API
JWT_SECRET="troque-este-segredo"
SUPABASE_JWT_SECRET=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
PORT=3333
CORS_ORIGIN="http://localhost:5173"

# Scheduled jobs
CRON_SECRET="troque-este-segredo"

# AgenSync billing via Asaas
BILLING_PROVIDER="ASAAS"
ASAAS_ENV="sandbox"
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
ASAAS_WALLET_ID=""
ASAAS_NOTIFICATION_DISABLED="false"
ASAAS_BASE_URL=""

# Firebase Admin (optional)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
ENABLE_PUSH_SEND="0"
